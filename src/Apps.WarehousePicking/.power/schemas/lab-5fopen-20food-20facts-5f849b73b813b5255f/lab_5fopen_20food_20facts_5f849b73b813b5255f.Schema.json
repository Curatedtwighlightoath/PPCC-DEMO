    "swagger": {
      "swagger": "2.0",
      "info": {
        "title": "Open Food Facts",
        "description": "Look up product data by barcode from the Open Food Facts public database.",
        "version": "1.0"
      },
      "host": "f72583ad7e23efd5aab5aba38b3d96.0e.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/19/apis/lab-5fopen-20food-20facts-5f849b73b813b5255f/connections/",
      "schemes": [
        "https",
        "http"
      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "operationId": "GetProductByBarcode",
            "summary": "Get product by barcode",
            "description": "Looks up a product by its EAN/UPC barcode.",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "x-ms-summary": "Barcode",
                "description": "The product's EAN/UPC barcode."
              }
            ],
            "responses": {
              "200": {
                "description": "The product",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              },
              "404": {
                "description": "No product found for this barcode"
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "operationId": "GetProductImage",
            "summary": "Get product image",
            "description": "Downloads a product image through the connector, so apps can display it.",
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "x-ms-summary": "Image URL",
                "description": "The image URL returned by Get product by barcode."
              }
            ],
            "responses": {
              "200": {
                "description": "The image bytes",
                "schema": {
                  "type": "file",
                  "format": "binary",
                  "x-ms-media-kind": "image"
                }
              },
              "400": {
                "description": "imageUrl query parameter is required"
              }
            }
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string",
              "x-ms-summary": "EAN"
            },
            "name": {
              "type": "string",
              "x-ms-summary": "Name"
            },
            "brand": {
              "type": "string",
              "x-ms-summary": "Brand"
            },
            "quantity": {
              "type": "string",
              "x-ms-summary": "Quantity"
            },
            "imageUrl": {
              "type": "string",
              "x-ms-summary": "Image URL"
            }
          }
        }
      },
